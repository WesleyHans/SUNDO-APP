{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/download-apk", "destination": "https://github.com/WesleyHans/SUNDO-APP/releases/download/v1.3.0/SUNDO.apk", "permanent": false },
    { "source": "/SUNDO.apk", "destination": "https://github.com/WesleyHans/SUNDO-APP/releases/download/v1.3.0/SUNDO.apk", "permanent": false },
    { "source": "/SUNDO-v1.0.0-release.apk", "destination": "https://github.com/WesleyHans/SUNDO-APP/releases/download/v1.3.0/SUNDO.apk", "permanent": false },
    { "source": "/sundo-release.apk", "destination": "https://github.com/WesleyHans/SUNDO-APP/releases/download/v1.3.0/SUNDO.apk", "permanent": false },
    { "source": "/sundo.apk", "destination": "https://github.com/WesleyHans/SUNDO-APP/releases/download/v1.3.0/SUNDO.apk", "permanent": false },
    { "source": "/app-release.apk", "destination": "https://github.com/WesleyHans/SUNDO-APP/releases/download/v1.3.0/SUNDO.apk", "permanent": false }
  ],
  "rewrites": [
